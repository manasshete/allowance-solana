# Copy to .env at the repo root. Every app reads it (packages/client/src/env.ts).

# Devnet RPC. A free Helius key avoids public rate limits.
RPC_URL=https://api.devnet.solana.com

# The vault's token. Circle devnet USDC by default; use your own 6-decimal mint if the faucet is down.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- facilitator (apps/facilitator) ---
FACILITATOR_PORT=4020
# solana-keygen JSON; needs ~0.5 devnet SOL to pay network fees for settled payments
FACILITATOR_KEYPAIR=keys/facilitator.json

# --- paid API (apps/paid-api) ---
PAID_API_PORT=4021
FACILITATOR_URL=http://localhost:4020
# payTo wallets of the demo merchants (each needs a token account for USDC_MINT)
MERCHANT_A=
MERCHANT_B=
MERCHANT_C=

# --- MCP server (apps/mcp) ---
# The agent's key. It can only spend through agent_pay; needs ~0.05 devnet SOL for refusal records and approvals.
AGENT_KEYPAIR=keys/agent.json
# The vault owner's wallet (your Phantom address)
OWNER=
MERCHANTS_FILE=config/merchants.json
DASHBOARD_URL=http://localhost:3100
